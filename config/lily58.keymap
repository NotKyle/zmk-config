/* Mouse cursor speed. ZMK_POINTING_DEFAULT_MOVE_VAL is an #ifndef-guarded
 * macro, not a Kconfig, so this must be defined before any include can pull in
 * pointing.h. Stock is 600. */
#define ZMK_POINTING_DEFAULT_MOVE_VAL 900

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

// Key positions (58):
//   row0  0.. 5 |  6..11      row1 12..17 | 18..23
//   row2 24..29 | 30..35      row3 36..42 | 43..49
//   thumbs  50 51 52 53 | 54 55 56 57

/* Cursor speed by layer. Scaling happens here rather than by rebinding the
 * movement keys, which is why the Slow and Fast layers are entirely
 * transparent — they fall straight through to the Mouse layer's own bindings.
 * ponytail: <multiplier divisor>. 1 4 is a quarter speed, 2 1 is double. */
&mmv_input_listener {
    slow {
        layers = <5>;
        input-processors = <&zip_xy_scaler 1 4>;
    };
    fast {
        layers = <6>;
        input-processors = <&zip_xy_scaler 2 1>;
    };
};

/ {
  // Hold both thumb layer keys (52 + 56) -> Numbers/Fn. No timing, no combo.
  conditional_layers {
    compatible = "zmk,conditional-layers";
    tri_layer {
      if-layers = <1 3>;
      then-layer = <2>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";

      // ---------------------------------------------------------------------------------------------------------------
      // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
      // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
      // | LSHFT |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
      // | CTRL  |  Z  |  X  |  C   |  V   |  B   | ESC  |  NUM      |  N   |  M    |  ,    |  .   |   /   | SHIFT |
      //                           | ALT  | GUI  | NAV  | SPACE |   | RET  | BSPC | SYM | CTRL |
      // ---------------------------------------------------------------------------------------------------------------

      bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                     &kp N6    &kp N7  &kp N8     &kp N9   &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W   &kp E   &kp R   &kp T                      &kp Y     &kp U   &kp I      &kp O    &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S   &kp D   &kp F   &kp G                      &kp H     &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C   &kp V   &kp B  &kp ESC    &mo 2    &kp N     &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                       &kp LALT  &kp LGUI  &mo 3  &kp SPACE  &kp RET   &kp BSPC  &mo 1   &kp LCTRL
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    lower_layer {
      display-name = "Symbols";

      // Held by the RIGHT thumb (56) -> most symbols sit on the left hand.
      // Brackets paired by finger: same finger position, opening on left, closing on right.
      // ---------------------------------------------------------------------------------------------------------------
      // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
      // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  +   |   =   |   ~   |
      // | CAPSW |  `  |  [  |  {   |  (   |  <   |                   |  >   |  )    |  }    |  ]   |   /   |   \   |
      // |       |  ~  |  |  |  _   |  -   |  :   |      |            |      |       |       |      |       |       |
      // ---------------------------------------------------------------------------------------------------------------

      bindings = <
&trans      &trans       &trans       &trans       &trans       &trans                    &trans     &trans    &trans    &trans    &trans    &trans
&trans      &kp EXCL     &kp AT       &kp HASH     &kp DOLLAR   &kp PRCNT                 &kp CARET  &kp AMPS  &kp ASTRK &kp PLUS  &kp EQUAL &kp TILDE
&caps_word  &kp GRAVE    &kp LBKT     &kp LBRC     &kp LPAR     &kp LT                    &kp GT     &kp RPAR  &kp RBRC  &kp RBKT  &kp FSLH  &kp BSLH
&trans      &kp TILDE    &kp PIPE     &kp UNDER    &kp MINUS    &kp COLON &trans  &trans  &trans     &trans    &trans    &trans    &trans    &trans
                                      &trans       &trans       &trans    &trans  &trans  &trans     &trans    &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    raise_layer {
      display-name = "Numbers";

      // Reached by holding BOTH thumb layer keys (52 + 56), or &mo 2 at position 43.
      // ---------------------------------------------------------------------------------------------------------------
      // |  BT0  | BT1 | BT2 | BT3 | BT4 |     |                   |      |      |      |      | RESET| BOOTL |
      // |   `   |  1  |  2  |  3  |  4  |  5  |                   |  6   |  7   |  8   |  9   |  0   |       |
      // |  F1   |  F2 |  F3 |  F4 |  F5 |  F6 |                   |  F7  |  F8  |  F9  | F10  | F11  |  F12  |
      // | BTCLR |     |     |     |     |     |      |            |      |      |      |      |      |       |
      // ---------------------------------------------------------------------------------------------------------------

      bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans     &trans  &trans  &trans  &trans   &sys_reset &bootloader
&kp GRAVE  &kp N1 &kp N2 &kp N3  &kp N4  &kp N5                       &kp N6  &kp N7  &kp N8  &kp N9   &kp N0   &trans
&kp F1     &kp F2 &kp F3 &kp F4  &kp F5  &kp F6                       &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&bt BT_CLR &trans &trans &trans  &trans  &trans    &trans   &trans    &trans  &trans  &trans  &trans   &trans   &trans
                         &trans  &trans  &trans    &trans   &trans    &trans  &trans  &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    nav_layer {
      display-name = "Nav";

      // Held by the LEFT thumb (52) -> all movement is on the right hand.
      // ---------------------------------------------------------------------------------------------------------------
      // |       |     |     |     |     |     |                   |      |       |       |      |      |       |
      // |       |     |     |     |     |     |                   | HOME | PG_DN | PG_UP | END  |      |       |
      // |       |     |     |     |MOUSE|     |                   | LEFT | DOWN  |  UP   |RIGHT |      |       |
      // |       |     |     |     |     |     |      |            | ^LFT | ~LFT  | ~RGT  | ^RGT |      |       |
      //                           |      |      |      |      |   |      | ~BSP |      | DEL   |
      // ---------------------------------------------------------------------------------------------------------------

      bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans        &trans         &trans         &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &kp HOME      &kp PG_DN      &kp PG_UP      &kp END         &trans  &trans
&trans  &trans  &trans  &trans  &mo 4   &trans                      &kp LEFT      &kp DOWN       &kp UP         &kp RIGHT       &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans     &kp LG(LEFT)  &kp LA(LEFT)   &kp LA(RIGHT)  &kp LG(RIGHT)   &trans  &trans
                        &trans  &trans  &trans  &trans   &trans        &kp LA(BSPC)  &trans      &kp DEL
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    mouse_layer {
      display-name = "Mouse";

      // Reached from Nav: hold NAV (left thumb 52) then left index home (28).
      // Speed rides on the left half's own Shift (faster) and Ctrl (slower).
      // The left hand holds, so the whole right hand is free — fingers move and
      // scroll, thumbs click. Position 28 stays transparent here so it keeps
      // resolving to &mo 4 on the layer below.
      // ---------------------------------------------------------------------------------------------------------------
      // |       |     |     |     |     |     |                   |      |      |      |      |      |       |
      // |       |     |     |     |     |     |                   | SCR← | SCR↓ | SCR↑ | SCR→ |      |       |
      // | FAST  |     |     |     |held |     |                   | MOU← | MOU↓ | MOU↑ | MOU→ |      |       |
      // | SLOW  |     |     |     |     |     |      |            | BACK | FWD  |      |      |      |       |
      //                           |      |      |      |      |   | LCLK | RCLK | MCLK |       |
      // ---------------------------------------------------------------------------------------------------------------

      bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans            &trans            &trans          &trans             &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &msc SCRL_LEFT    &msc SCRL_DOWN    &msc SCRL_UP    &msc SCRL_RIGHT    &trans  &trans
&mo 6   &trans  &trans  &trans  &trans  &trans                      &mmv MOVE_LEFT    &mmv MOVE_DOWN    &mmv MOVE_UP    &mmv MOVE_RIGHT    &trans  &trans
&mo 5   &trans  &trans  &trans  &trans  &trans  &trans   &trans     &mkp MB4          &mkp MB5          &trans          &trans             &trans  &trans
                        &trans  &trans  &trans  &trans   &mkp LCLK  &mkp RCLK         &mkp MCLK         &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    slow_layer {
      display-name = "Slow";

      // Quarter speed, for landing on a small target. Entirely transparent: the speed change is an input processor on
      // mmv_input_listener, so every key still comes from the Mouse layer.

      bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans     &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans   &trans     &trans  &trans  &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };

    fast_layer {
      display-name = "Fast";

      // Double speed, for crossing the screen. Entirely transparent: the speed change is an input processor on
      // mmv_input_listener, so every key still comes from the Mouse layer.

      bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans     &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans   &trans     &trans  &trans  &trans
      >;

      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
  };
};
